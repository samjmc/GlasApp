{
  "name": "glasapp",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch --clear-screen=false server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run --root .",
    "test:e2e": "playwright test",
    "guard:migrations": "tsx scripts/ci/check-migrations.ts",
    "guard:tests": "tsx scripts/ci/check-test-discovery.ts",
    "guard:code": "tsx scripts/ci/check-code-guards.ts",
    "facts": "tsx scripts/ci/generate-facts.ts",
    "facts:check": "tsx scripts/ci/generate-facts.ts --check",
    "docs:check": "tsx scripts/ci/check-doc-facts.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "sync-tds": "tsx server/jobs/sync-tds.ts",
    "news:tds": "tsx server/jobs/news-tds.ts",
    "scores:recalculate": "tsx server/jobs/scores-recalculate.ts",
    "ideology": "tsx server/jobs/ideology.ts",
    "quiz:review": "tsx scripts/quiz-review.ts",
    "stances": "tsx server/jobs/stances.ts",
    "td-history": "tsx server/jobs/td-history.ts",
    "parliament:sync": "tsx server/jobs/parliament-sync.ts",
    "parliament:silences": "tsx server/jobs/parliament-silences.ts",
    "parliament:leave-watch": "tsx server/jobs/parliament-leave-watch.ts",
    "debates:items": "tsx server/jobs/debate-items.ts",
    "questions:items": "tsx server/jobs/question-items.ts",
    "party-quiz": "tsx server/jobs/party-quiz.ts",
    "quiz:analyse": "tsx server/jobs/quiz-analyse.ts",
    "robots": "tsx server/jobs/robots.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "cheerio": "^1.2.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^7.2.0",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "openai": "^4.100.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rss-parser": "^3.13.0",
    "undici": "^7.30.1",
    "unpdf": "1.9.1",
    "zod": "^3.25.76",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hookform/resolvers": "^7.0.3",
    "@playwright/test": "1.65.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.106.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/multer": "^2.3.0",
    "@types/node": "22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "framer-motion": "^14.10.1",
    "globals": "^17.14.0",
    "html2canvas": "^1.4.1",
    "jsdom": "^26.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.70.0",
    "nanoid": "^6.0.2",
    "postcss": "^8.5.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.21",
    "vitest": "^3.2.4",
    "wouter": "^3.13.0"
  }
}
