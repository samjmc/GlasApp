# Copy to deploy/glasapp.env (git-ignored) and fill in. Names only: never commit values.
# One KEY=value per line, no quotes. See docs/deploy.md.
#
# A line that starts with # is NOT set. Uncomment a line only when you have a value for it:
# an empty value is set to an empty string, which is not the same as unset (an empty
# SUPABASE_SERVICE_ROLE_KEY, for example, stops the server at start-up).

# --- Required: the server stops at start-up without these three ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Build time: baked into the client bundle by `docker compose ... --build` ---
# VITE_SUPABASE_ANON_KEY is required by the compose file. VITE_SUPABASE_URL is optional.
VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_URL=

# --- Needed for real use ---
# SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_EMAILS=
# One secret for admin and job calls. Any of ADMIN_API_SECRET, ADMIN_SECRET, CRON_SECRET or
# JOB_SECRET works (checked in that order).
# ADMIN_API_SECRET=
# LLM_API_KEY=
# JEV_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=

# --- Optional ---
# LLM_BASE_URL=
# LLM_MODEL_NAME=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# REDIS_URL=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# LOG_LEVEL=

# --- Scheduled jobs: leave SCHEDULER=off for the first boot ---
SCHEDULER=off
# DIVISION_STANCES=on and DEBATE_ITEMS=on each add a nightly step that calls the model.
# DIVISION_STANCES=on
# DEBATE_ITEMS=on

# --- Only with --profile proxy ---
# SITE_DOMAIN=
