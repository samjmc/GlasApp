# Copy to deploy/glasapp.env (git-ignored) and fill in. Names only: never commit values.
# One KEY=value per line, no quotes. See docs/deploy.md.
#
# A $ inside a value must be written $$. Compose reads $name as a variable and, if it is not set,
# silently drops it with only a warning (checked with Compose 5: pa$word becomes pa). A generated
# secret can contain a $.
#
# A line that starts with # is NOT set. Uncomment a line only when you have a value for it:
# an empty value is set to an empty string, which is not the same as unset (an empty
# SUPABASE_SERVICE_ROLE_KEY, for example, stops the server at start-up).

# --- Required: the server stops at start-up without these four ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Account deletion and region saves need it. In production there is no fallback to the anon key.
SUPABASE_SERVICE_ROLE_KEY=

# --- Build time: baked into the client bundle by `docker compose ... --build` ---
# VITE_SUPABASE_ANON_KEY is required by the compose file. VITE_SUPABASE_URL defaults to the GlasCore
# project (client/src/lib/supabase.ts): leave it out only if SUPABASE_URL above is GlasCore too. With
# your own Supabase project set it to the same value as SUPABASE_URL, or the browser signs in against
# GlasCore while the server checks tokens against yours, and every signed-in call is a 401.
VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_URL=

# --- Needed for real use ---
# ADMIN_EMAILS=
# One secret for admin and job calls. Any of ADMIN_API_SECRET, ADMIN_SECRET, CRON_SECRET or
# JOB_SECRET works (checked in that order).
# ADMIN_API_SECRET=
# LLM_API_KEY=
# JEV_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=

# --- Optional ---
# LLM_BASE_URL=
# LLM_MODEL_NAME=
# OPENAI_API_KEY=
# REDIS_URL=
# LOG_LEVEL=
# Database connections this server may hold (default 10, at most 50). The session pooler's Pool
# Size in Supabase (Database > Connection pooling) is 15 and SHARED with GlasIntelligence: raise
# it first, then this, and leave GlasIntelligence its share.
# DB_POOL_MAX=

# --- Scheduled jobs: leave SCHEDULER=off for the first boot ---
SCHEDULER=off
# DIVISION_STANCES=on, DEBATE_ITEMS=on and QUESTION_ITEMS=on each add a nightly step that calls the
# model. DIVISION_STANCES=on also PUBLISHES the matched divisions as TD stances (docs/deploy.md section 6).
# DIVISION_STANCES=on
# DEBATE_ITEMS=on
# QUESTION_ITEMS=on

# --- Only with --profile proxy ---
# SITE_DOMAIN=
