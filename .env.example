# Copy to .env and fill in. Never commit .env.

# --- Database (GlasCore Supabase project, shared with GlasIntelligence) ---------------
# Direct Postgres connection string from Supabase → Project Settings → Database.
# GlasApp's tables live in the `politics` schema; GlasIntelligence's in `public`.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
# Optional: a non-pooled connection for migrations (drizzle-kit migrate/push).
DIRECT_URL=

# --- Supabase Auth (bearer tokens) and the legacy REST client -------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Server ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
SESSION_SECRET=                # required in production
ADMIN_EMAILS=                  # comma-separated; grants admin without app_metadata.role, confirmed emails only
ADMIN_API_SECRET=              # x-admin-secret header for cron/admin endpoints

# --- AI -------------------------------------------------------------------------------
# Chat completions (news ranking, TD scoring panel, chat, quiz). When LLM_API_KEY is set every
# chat call runs on DeepSeek; otherwise on OpenAI.
LLM_API_KEY=                   # DeepSeek key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-flash  # DeepSeek V4.1 Flash
# Embeddings only (debate search). DeepSeek has no embeddings API.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
